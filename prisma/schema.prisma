// Prisma schema for Job Hunting Tracker Spreadsheet
// Multi-tenant app-level isolation: every domain row is scoped by userId.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js v5 (NextAuth) models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  targetMonthly Int       @default(20)

  accounts     Account[]
  sessions     Session[]
  applications Application[]
  companies    Company[]
  statuses     Status[]
  projects     Project[]
  tasks        Task[]
  resources    Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Domain models ---
model Company {
  id        String   @id @default(cuid())
  name      String
  location  String?
  website   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]
  projects     Project[]

  createdAt DateTime @default(now())

  @@unique([name, userId])
  @@index([userId])
}

model Status {
  id        String  @id @default(cuid())
  name      String
  color     String
  order     Int     @default(0)
  isDefault Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
  @@index([userId])
}

model Application {
  id             String    @id @default(cuid())
  companyName    String    @default("")
  position       String
  location       String?   @default("Jakarta")
  platform       String    @default("Jobstreet") // Jobstreet, LinkedIn, Glints, KitaLulus, Kalibrr, Dealls, Email, Website Karir, Lainnya
  email          String?
  jobUrl         String?
  appliedAt      DateTime  @default(now())
  status         String    @default("Lamaran Dikirim") // Lamaran Dikirim, Wawancara, Offering, Diterima, Ditolak
  
  // Wawancara fields
  interviewDate  DateTime?
  interviewVia   String?   // Google Meet, Zoom, Onsite, MS Teams, WhatsApp, Telepon
  interviewNotes String?

  jobType        String?   @default("Full-time")
  recruiter      String?
  salary         String?
  notes          String?
  cvUrl          String?
  portfolioUrl   String?

  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  statusId       String?
  statusRel      Status?   @relation(fields: [statusId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([platform])
  @@index([appliedAt])
}

model Project {
  id          String    @id @default(cuid())
  name        String    @default("Project")
  key         String    @default("PROJ")
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  engagement  String    @default("Project")
  status      String    @default("Planning")
  leadName    String?
  leadAvatar  String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks     Task[]
  resources Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
}

model Task {
  id          String    @id @default(cuid())
  title       String    @default("Task")
  description String?
  status      String    @default("Backlog")
  priority    String    @default("Medium")
  dueDate     DateTime?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model Resource {
  id    String @id @default(cuid())
  title String @default("Resource")
  url   String @default("https://")
  type  String @default("link")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
}
